# Postgres в docker-compose (читается Compose автоматически из .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_l2_assistant

# Приложение, запущенное на хосте (uv run uvicorn ...), ходит в БД через проброшенный порт
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_l2_assistant
